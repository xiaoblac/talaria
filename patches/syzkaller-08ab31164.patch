+static uint64 tl_pending_parent_engine_cpu, tl_pending_parent_engine_rq;
+static uint64 tl_pending_parent_post_cpu, tl_pending_parent_post_rq;
+static uint64 tl_pending_parent_idle_cpu, tl_pending_parent_idle_rq;
+static bool tl_pending_parent_pre_cpu_valid, tl_pending_parent_engine_cpu_valid;
+static bool tl_pending_parent_post_cpu_valid, tl_pending_parent_idle_cpu_valid;
+static struct tl_parent_point tl_pending_parent_engine_end;
+
+static uint64 exec_cpu_done, exec_cpu_execution, exec_cpu_parent_active;
+static uint64 exec_cpu_parent_idle, exec_cpu_missing, exec_cpu_last_emit;
+
+static void perf_emit(const char* buf, int len)
+{
+	if (perf_fd < 0 || len <= 0)
+		return;
+	// Non-blocking and best-effort: a full uart must never stall or fail the
+	// fuzzer, and errno must not leak into the caller's error handling.
+	int saved_errno = errno;
+	ssize_t wrote = write(perf_fd, buf, len);
+	(void)wrote;
+	errno = saved_errno;
+}
+
+static bool process_cputime_us(uint64* out)
+{
+	struct timespec ts = {};
+	if (!out || clock_gettime(CLOCK_PROCESS_CPUTIME_ID, &ts))
+		return false;
+	*out = (uint64)ts.tv_sec * 1000000 + (uint64)ts.tv_nsec / 1000;
+	return true;
+}
+
+static bool reaped_children_cputime_us(uint64* out)
+{
+	struct rusage usage = {};
+	if (!out || getrusage(RUSAGE_CHILDREN, &usage))
+		return false;
+	*out = (uint64)usage.ru_utime.tv_sec * 1000000 + usage.ru_utime.tv_usec +
+	       (uint64)usage.ru_stime.tv_sec * 1000000 + usage.ru_stime.tv_usec;
+	return true;
+}
+
+static void exec_cpu_accumulate_pending(void)
+{
+	bool missing = false;
+	if (tl_pending_b && tl_pending_c >= tl_pending_b &&
+	    tl_pending_c_cpu >= tl_pending_b_cpu) {
+		exec_cpu_execution += tl_pending_c_cpu - tl_pending_b_cpu;
+	} else {
+		missing = true;
+	}
+	if (tl_pending_parent_pre_cpu_valid &&
+	    tl_pending_parent_engine_cpu_valid &&
+	    tl_pending_parent_post_cpu_valid) {
+		exec_cpu_parent_active += tl_pending_parent_pre_cpu +
+					  tl_pending_parent_engine_cpu +
+					  tl_pending_parent_post_cpu;
+	} else {
+		missing = true;
+	}
+	if (tl_pending_parent_idle_cpu_valid)
+		exec_cpu_parent_idle += tl_pending_parent_idle_cpu;
+	else
+		missing = true;
+	if (!tl_pending_reap)
+		missing = true;
+	exec_cpu_done++;
+	if (missing)
+		exec_cpu_missing++;
+}
+
+static void exec_cpu_report(bool force)
+{
+	const uint64 report_interval_us = 5000000;
+	uint64 now = current_time_us();
+	if (!force && exec_cpu_last_emit && now - exec_cpu_last_emit < report_interval_us)
+		return;
+	uint64 process_cpu = 0;
+	uint64 children_cpu = 0;
+	if (!process_cputime_us(&process_cpu) ||
+	    !reaped_children_cputime_us(&children_cpu))
+		return;
+	char buf[384];
+	perf_emit(buf, snprintf(buf, sizeof(buf),
+				"[SyzExecCPU] wid=%llu t=%llu done=%llu pc=%llu ch=%llu"
+				" ex=%llu pa=%llu pi=%llu miss=%llu\n",
+				procid, (unsigned long long)now,
+				(unsigned long long)exec_cpu_done,
+				(unsigned long long)process_cpu,
+				(unsigned long long)children_cpu,
+				(unsigned long long)exec_cpu_execution,
+				(unsigned long long)exec_cpu_parent_active,
+				(unsigned long long)exec_cpu_parent_idle,
+				(unsigned long long)exec_cpu_missing));
+	exec_cpu_last_emit = now;
+}
+
+// Cumulative, never reset -- same semantics as reFuzz's accumulator, so the same
+// parser serves both: the last line per (wid, stage) is the whole-run snapshot and
+// lines must never be summed. wid=procid keeps the procs that share this serial
+// apart.
+static void perf_report(void)
+{
+	if (perf_fd < 0 || perf_samples == 0)
+		return;
+	uint64 total_us = 0;
+	for (unsigned i = 0; i < kPerfStages; i++)
+		total_us += perf_stage_us[i];
+	char buf[256];
+	for (unsigned i = 0; i < kPerfStages; i++) {
+		perf_emit(buf, snprintf(buf, sizeof(buf),
+					"[SyzPerfStage] wid=%llu scope=loop relation=exclusive stage=%s n=%llu avg_us=%llu\n",
+					procid, perf_stage_names[i], (unsigned long long)perf_samples,
+					(unsigned long long)(perf_stage_us[i] / perf_samples)));
+	}
+	perf_emit(buf, snprintf(buf, sizeof(buf),
+				"[SyzPerfStage] wid=%llu scope=loop relation=total stage=total n=%llu avg_us=%llu\n",
+				procid, (unsigned long long)perf_samples,
+				(unsigned long long)(total_us / perf_samples)));
+}
