+// [first-layer perf] The four things the fork-server parent actually does per
+// program. Mirrors reFuzz's worker-perf `scope=loop` so both fuzzers report the
+// same decomposition and one parser serves both. Only `executor` -- fork + the
+// child's syscalls + reap -- is the execution unit the two fuzzers share; the
+// other three are what this execution model spends around it. receive_execute()
+// (the block-wait for the next request) is deliberately not counted, so an idle
+// queue is never charged as execution cost.
+//
+// Output goes to a dedicated serial, never ttyS0: ttyS0 is the console
+// syz-manager parses for crashes, whereas QEMU writes a second `-serial file:...`
+// straight into a host file. Without that serial the open below fails, perf_fd
+// stays -1 and every hook no-ops, so an ordinary run is unaffected. All four
+// phases run in the parent, outside any KCOV window (KCOV is per-task and only
+// enabled in the child's execute_one), so these writes cannot land in a program's
+// coverage the way a write from inside a call window would.
+#define kPerfSerial "/dev/ttyS1"
+#define kPerfReportEvery 128
+
+static uint64 current_time_us(void)
+{
+	struct timespec ts;
+	if (clock_gettime(CLOCK_MONOTONIC, &ts))
+		fail("clock_gettime failed");
+	return (uint64)ts.tv_sec * 1000000 + (uint64)ts.tv_nsec / 1000;
+}
+
+// [ExecTL] CPU time this thread has consumed; differenced around fork() it
+// splits the fork into on-CPU kernel work vs waiting (runqueue or blocked).
+static uint64 thread_cputime_us(void)
+{
+	struct timespec ts;
+	if (clock_gettime(CLOCK_THREAD_CPUTIME_ID, &ts))
+		return 0;
+	return (uint64)ts.tv_sec * 1000000 + (uint64)ts.tv_nsec / 1000;
+}
+
+struct tl_parent_point {
+	uint64 cpu_us;
+	uint64 rq_us;
+	bool cpu_valid;
+	bool rq_valid;
+};
+
+struct tl_parent_delta {
+	uint64 cpu_us;
+	uint64 rq_us;
+	bool cpu_valid;
+	bool rq_valid;
+};
+
+// The loop parent is single-request, so deltas of its thread counters can be
+// charged to that request. schedstat's second field is cumulative runqueue
+// wait in ns; a missing CONFIG_SCHED_INFO (or a transient read failure) makes
+// only the rq component unavailable for that interval.
+static struct tl_parent_point tl_parent_sample(void)
+{
+	struct tl_parent_point point = {};
+	struct timespec ts;
+	if (clock_gettime(CLOCK_THREAD_CPUTIME_ID, &ts) == 0) {
+		point.cpu_us = (uint64)ts.tv_sec * 1000000 + (uint64)ts.tv_nsec / 1000;
+		point.cpu_valid = true;
+	}
+	int fd = open("/proc/self/schedstat", O_RDONLY | O_CLOEXEC);
+	if (fd < 0)
+		return point;
+	char buf[96] = {};
+	ssize_t n = read(fd, buf, sizeof(buf) - 1);
+	close(fd);
+	if (n <= 0)
+		return point;
+	unsigned long long runtime_ns = 0;
+	unsigned long long wait_ns = 0;
+	if (sscanf(buf, "%llu %llu", &runtime_ns, &wait_ns) == 2) {
+		point.rq_us = wait_ns / 1000;
+		point.rq_valid = true;
+	}
+	return point;
+}
+
+static struct tl_parent_delta tl_parent_diff(struct tl_parent_point begin,
+					      struct tl_parent_point end)
+{
+	struct tl_parent_delta delta = {};
+	if (begin.cpu_valid && end.cpu_valid && end.cpu_us >= begin.cpu_us) {
+		delta.cpu_us = end.cpu_us - begin.cpu_us;
+		delta.cpu_valid = true;
+	}
+	if (begin.rq_valid && end.rq_valid && end.rq_us >= begin.rq_us) {
+		delta.rq_us = end.rq_us - begin.rq_us;
+		delta.rq_valid = true;
+	}
+	return delta;
+}
+
+static const char* const perf_stage_names[] = {"prepare", "executor", "delivery", "cleanup"};
+#define kPerfStages (sizeof(perf_stage_names) / sizeof(perf_stage_names[0]))
+static uint64 perf_stage_us[kPerfStages];
+static uint64 perf_samples;
+static int perf_fd = -1;
+
+// [ExecTL] execution-timeline record of the previous request. Emitted one
+// iteration later, once its R (ready point) and A' (next-request arrival) are
+// known. B/C stamps (wall + process CPU + main-thread runqueue wait) come from
+// the shared output header where the worker child wrote them; fork and rusage
+// numbers are taken in this process.
+static bool tl_pending_valid;
+static uint64 tl_pending_id, tl_pending_b, tl_pending_c, tl_pending_reap;
+static uint64 tl_pending_b_cpu, tl_pending_b_rq, tl_pending_c_cpu, tl_pending_c_rq;
+static uint64 tl_pending_fork_wall, tl_pending_fork_cpu;
+static uint64 tl_pending_child_cpu, tl_pending_child_nivcsw, tl_pending_child_minflt;
