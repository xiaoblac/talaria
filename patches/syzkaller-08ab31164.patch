+// [fixed request stream] streamReplayer serves a pre-decoded, ordered request
+// stream as the manager's only workload source.
+//
+// Two invariants the reFuzz side had to learn the hard way and that are built in
+// here from the start:
+//
+//  1. A record that will not deserialize is NOT emitted, is counted, and is
+//     reported. Substituting anything for it -- a skip that is not counted, a
+//     fallback path -- would make the two systems run different workloads while
+//     still reporting a full replay.
+//  2. "The stream ran out" is NOT the same as "the replay finished". Requests
+//     still in flight can be lost (crashed VM, restarted worker), and a run that
+//     silently stops short is indistinguishable from a complete one unless
+//     completions are counted separately from emissions. So the finish condition
+//     is `exhausted AND completed == emitted`, and a stall in that final wait is
+//     reported as an incomplete replay rather than papered over.
+type streamReplayer struct {
+	target     *prog.Target
+	records    []requeststream.Record
+	onFinished func(replayed, emitted, undecodable int, complete bool)
+
+	mu          sync.Mutex
+	pos         int
+	emitted     int
+	completed   int
+	undecodable int
+	exhausted   bool
+	finished    bool
+}
+
+// How long the post-exhaustion wait may make no progress before the replay is
+// declared incomplete. Generous relative to a single program timeout: the point
+// is to catch requests that will never come back, not to race a slow tail.
+const replayDrainStallTimeout = 5 * time.Minute
+
+func newStreamReplayer(target *prog.Target, records []requeststream.Record,
+	onFinished func(replayed, emitted, undecodable int, complete bool)) *streamReplayer {
+	sr := &streamReplayer{target: target, records: records, onFinished: onFinished}
+	go sr.watchDrain()
+	return sr
+}
+
+func (sr *streamReplayer) Next() *queue.Request {
+	sr.mu.Lock()
+	defer sr.mu.Unlock()
+	for sr.pos < len(sr.records) {
+		rec := sr.records[sr.pos]
+		sr.pos++
+		p, err := sr.target.Deserialize(rec.ProgText, prog.NonStrict)
+		if err != nil {
+			sr.undecodable++
+			// Loud for the first few, then silent -- a systematically broken stream
+			// should not drown the log, but it must not be invisible either.
+			if sr.undecodable <= 10 {
+				log.Logf(0, "stream replay: record %v does not deserialize, not emitted: %v",
+					rec.Sequence, err)
+			}
+			continue
+		}
+		sr.emitted++
+		req := &queue.Request{
+			Type: flatrpc.RequestType(rec.RequestType),
+			Prog: p,
+			ExecOpts: flatrpc.ExecOpts{
+				EnvFlags:   flatrpc.ExecEnv(rec.ExecEnvFlags),
+				ExecFlags:  flatrpc.ExecFlag(rec.ExecFlags),
+				SandboxArg: rec.SandboxArg,
+			},
+			ReturnError:  rec.RequestFlags&uint64(flatrpc.RequestFlagReturnError) != 0,
+			ReturnOutput: rec.RequestFlags&uint64(flatrpc.RequestFlagReturnOutput) != 0,
+			// Important so a crashed VM retries the request instead of dropping it:
+			// a dropped request is a hole in the controlled workload.
+			Important: true,
+		}
+		for _, call := range rec.AllSignal {
+			req.ReturnAllSignal = append(req.ReturnAllSignal, int(call))
+		}
+		// [RTT] Stamp the two stages the fuzzer would normally own. Everything
+		// downstream (Dequeued/Sent/Executing/CompletionObserved/ResultReceived/
+		// FinalDone) is stamped by pkg/rpcserver and is mode-independent, but
+		// `Sampled` and `CreatedUs` are set in fuzzer.prepare() -- which this mode
+		// deliberately does not have. Without them the sampling decision is never
+		// made, `Sampled` stays false, and the whole RTT trace comes out empty
+		// while the -task-trace flags look like they took effect. Observed
+		// 2026-07-25: a complete 34424-record replay produced a zero-byte JSONL.
+		//
+		// CreatedUs and EnqueuedUs are the same instant here, and that is not a
+		// shortcut: a replayed request is minted only when the RPC server asks for
+		// one, so it never waits in a host-side queue. Host queue wait is therefore
+		// structurally zero in this mode -- a real property of replay, not a gap.
+		// It is also why RTT totals must not be compared between replay and a
+		// fuzzing capture (see docs/plans/execution-mechanism-experiments.md
+		// appendix A).
+		req.Trace.Sampled = queue.ShouldSampleTaskTrace(uint32(*flagTaskTraceSampleRate))
+		if req.Trace.Sampled {
+			now := queue.TraceNowUs()
+			req.Trace.CreatedUs = now
+			req.Trace.EnqueuedUs = now
+		}
+		req.OnDone(sr.onDone)
+		return req
+	}
+	if !sr.exhausted {
+		sr.exhausted = true
+		log.Logf(0, "stream replay: stream exhausted, %v emitted (%v undecodable), waiting for %v in flight",
+			sr.emitted, sr.undecodable, sr.emitted-sr.completed)
+	}
+	sr.maybeFinishLocked()
+	return nil
+}
+
+func (sr *streamReplayer) onDone(*queue.Request, *queue.Result) bool {
+	sr.mu.Lock()
+	defer sr.mu.Unlock()
+	sr.completed++
+	sr.maybeFinishLocked()
+	return true
+}
+
+func (sr *streamReplayer) maybeFinishLocked() {
+	if sr.finished || !sr.exhausted || sr.completed < sr.emitted {
+		return
+	}
+	sr.finished = true
+	go sr.onFinished(sr.completed, sr.emitted, sr.undecodable, true)
+}
+
+// watchDrain fires only after the stream is exhausted: while records are still
+// being served, "no completions for a while" just means the programs are slow.
+func (sr *streamReplayer) watchDrain() {
+	last, stalled := -1, time.Duration(0)
+	for range time.NewTicker(10 * time.Second).C {
+		sr.mu.Lock()
+		if sr.finished {
+			sr.mu.Unlock()
+			return
+		}
+		exhausted, completed, emitted, undecodable := sr.exhausted, sr.completed, sr.emitted, sr.undecodable
+		sr.mu.Unlock()
+		if !exhausted {
+			continue
+		}
+		if completed != last {
+			last, stalled = completed, 0
+			continue
+		}
+		stalled += 10 * time.Second
+		if stalled < replayDrainStallTimeout {
+			continue
+		}
+		sr.mu.Lock()
+		if sr.finished {
+			sr.mu.Unlock()
+			return
+		}
+		sr.finished = true
+		sr.mu.Unlock()
+		go sr.onFinished(completed, emitted, undecodable, false)
+		return
+	}
+}
+
+// holdForGuestProbeFetch publishes "quiesced, VM still alive" and blocks until an
+// external driver releases teardown (or the backstop expires). The marker's
+// CONTENT, not its existence, carries the verdict: the driver must be able to
+// tell a full replay from a truncated one, and both reach this point.
+//
+// Failure to create the marker is NOT fatal -- the run's results are already on
+// disk, so refusing to tear down would trade a finished run for a hang.
+func holdForGuestProbeFetch(complete bool) {
+	if *flagReplayDrainedMarker == "" {
+		return
+	}
+	verdict := "incomplete\n"
+	if complete {
+		verdict = "drained\n"
+	}
+	if err := os.WriteFile(*flagReplayDrainedMarker, []byte(verdict), 0o644); err != nil {
+		log.Logf(0, "stream replay: cannot publish drained marker %v: %v; proceeding to teardown",
+			*flagReplayDrainedMarker, err)
+		return
+	}
+	if *flagReplayRelease == "" {
+		log.Logf(0, "stream replay: drained marker published but no -replay-release; proceeding to teardown")
+		return
+	}
+	log.Logf(0, "stream replay: quiesced (%v); VM held for guest probe fetch, waiting on %v",
+		verdict[:len(verdict)-1], *flagReplayRelease)
+	began := time.Now()
+	for {
+		if _, err := os.Stat(*flagReplayRelease); err == nil {
+			log.Logf(0, "stream replay: released after %v", time.Since(began).Truncate(time.Second))
+			return
+		}
+		if *flagReplayHoldTimeout != 0 && time.Since(began) >= *flagReplayHoldTimeout {
+			log.Logf(0, "stream replay: no release after %v; tearing down anyway",
+				flagReplayHoldTimeout)
+			return
+		}
+		time.Sleep(200 * time.Millisecond)
+	}
+}
+
+// replayFinished is the single exit point for -mode stream-replay. A complete
+// replay exits 0; anything short exits non-zero, so a driver script cannot
+// mistake a truncated measurement for a full one.
+func (mgr *Manager) replayFinished(replayed, emitted, undecodable int, complete bool) {
+	// Hold BEFORE reporting the verdict: the driver needs the guest alive to fetch
+	// its probe, and it needs that whether the replay was complete or truncated --
+	// a truncated run's guest data is still worth keeping.
+	holdForGuestProbeFetch(complete && undecodable == 0)
+	if complete && undecodable == 0 {
+		log.Logf(0, "stream replay: complete, %v/%v records replayed", replayed, emitted)
+		mgr.exit("stream replay")
+		return
+	}
+	log.Logf(0, "stream replay INCOMPLETE: %v/%v emitted requests completed, %v records undecodable",
+		replayed, emitted, undecodable)
+	mgr.writeBench()
+	close(vm.Shutdown)
+	time.Sleep(10 * time.Second)
+	os.Exit(1)
+}
+
 func (mgr *Manager) corpusMinimization() {
 	for range time.NewTicker(time.Minute).C {
 		mgr.mu.Lock()
