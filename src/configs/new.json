{
    "profile": "kernel",
    "work_dir": "/workspace/talaria/run",
    "state_dir": "",
    "retention": false,
    "retention_max": 3,

    "channel": {
      "fuzz_channel_count": 1,
      "wait_ready_timeout_ms": 60000,
      "loop_interval_ms": 100,
      "health_check_interval_ms": 500,
      "pre_reboot_drain_ms": 5500,
      "input_queue_capacity": 64,
      "abnormal_console_snapshot_lines": 80,
      "vm": {
        "arch": "amd64",
        "image": "/workspace/images-test-linux5.14/bookworm.img",
        "kernel": "/workspace/syzkaller/kernel/build-kasan/arch/x86/boot/bzImage",
        "ssh_key": "/workspace/images-test-linux5.14/bookworm.id_rsa",
        "ssh_user": "root",
        "qemu": {
          "qemu": "qemu-system-x86_64",
          "cpu": 2,
          "mem": 2048,
          "cmdline": "nokaslr panic=1 oops=panic",
          "snapshot": true,
          "snapshot_fuzzing": false,
          "serial_log_path": ""
        }
      },
      "transport": {
        "n_workers": 1,
        "ivshmem_path": "/tmp/refuzz_ivshmem_phase1",
        "ivshmem_mode": "plain",
        "doorbell_socket_path": "/tmp/refuzz_ivshmem_phase1.sock",
        "ivshmem_vectors": 1,
        "wait_ready_poll_us": 1000,
        "poll_sleep_us": 100
      },
      "health": {
        "enable": true,
        "sample_interval_ms": 250,
        "heartbeat_timeout_ms": 4000,
        "heartbeat_miss_threshold": 0,
        "workers_per_round": 0,
        "vm_dead_timeout_ms": 30000,
        "recovery_window_base_ms": 90000,
        "recovery_window_cap_ms": 600000,
        "cascade_window_ms": 120000,
        "cascade_reboot_budget": 2
      }
    },

    "executor": {
      "idle_sleep_us": 1000000,
      "submit_wait_for_slot_ms": 0,
      "submit_strategy": { "name": "round_robin" },
      "event_forward_strategy": { "blocking_timeout_ms": 1 },
      "timeouts_ms": { "poll": 1, "pop": 5 }
    },

    "fuzzer": {
      "high_watermark": 64,
      "exec_timeout_ms": 5000,
      "shutdown_grace_ms": 60000,
      "mutator_policy": "syz_balanced",
      "worker_log": { "enable": false },
      "worker_perf": { "enable": false, "sample_rate": 1, "report_every": 256 },
      "corpus": { "capacity": 10000, "max_drain": 32 }
    },

    "telemetry": {
      "policy_monitor": {
        "min_dwell_seconds": 300,
        "window_size": 10,
        "stall_threshold": 0.01,
        "required_windows": 3,
        "degraded_channel_ratio": 0.5
      },
      "observability": { "pull_interval_ms": 1000 },
      "dashboard": {
        "enable": true,
        "refresh_interval_ms": 500,
        "max_events": 6,
        "use_alternate_screen": true
      },
      "logging": {
        "enable": true,
        "stream": false,
        "path": "",
        "flush_interval_ms": 250,
        "console_summary": true,
        "hot_path_sample_rate": 0
      }
    },

    "coverage": {
      "kcov": {
        "raw_pc": true,
        "max_pcs_per_exec": 0,
        "sample_rate": 1.0,
        "entries": 524288,
        "output_dir": ""
      },
      "export": {
        "enabled": false,
        "corpus_pc_path": ""
      }
    },

    "target": {
      "execution_mode": "kernel_syscall",
      "coverage_mode": "kcov",
      "sanitizer_mode": "none",
      "sandbox_mode": "none",
      "thread_count": 1,
      "intra_task_mode": "serial",
      "kcov_collector_count": 8,
      "kcov_premap_count": 3,
      "per_call_timeout_ms": 500,
      "metric_dump_path": "",
      "debug_smaps": false,
      "debug_empty_fork": false,
      "debug_mount_timing": false,
      "debug_topology_probe": false,
      "warmup_devices": false
    },

    "persistence": {
      "corpus":   { "enable": true, "dir": "", "load_on_start": true },
      "coverage": { "enable": true, "path": "", "load_on_start": true },
      "crash_repros_as_seeds": true
    },

    "repro": {
      "enable": false,
      "dedicated_vm_count": 1,
      "vmlinux_path": "/workspace/syzkaller/kernel/build-kasan/vmlinux",
      "addr2line_binary": "addr2line",
      "queue_capacity": 64,
      "execute_timeout_ms": 30000
    },

    "components": {
      "mutator_engine": "syz",
      "scheduler_engine": "priority_scheduler",
      "corpus_store": "in_memory",
      "corpus_admission": "",
      "feedback_engine": "kernel_kcov",
      "channel_backend_id": "",
      "target_toolkit": "kernel_linux_syz"
    },

    "feedback_engine_spec": {
      "engine_id": "kernel_kcov",
      "signal_ids": ["kernel_kcov"],
      "aggregator_id": "weighted_sum",
      "aggregator_context": {
        "signal_weights": { "kernel_kcov": 1.0 },
        "interesting_threshold": 0.0
      }
    },

    "stages": {
      "stage_specs": {
        "gen_p":  { "type_id": "generate_producer",   "side": "producer", "state_scope": "gen_p", "params": { "generate_percent": "5" } },
        "mut_p":  { "type_id": "mutational_producer",  "side": "producer", "state_scope": "mut_p" },
        "mut_c":  { "type_id": "mutational_consumer",  "side": "consumer", "state_scope": "mut_c" }
      },
      "producer_chain": ["gen_p", "mut_p"],
      "consumer_chain": ["mut_c"]
    },

    "phase0_worker_bin": "/workspace/talaria/build-llvm20/executor/channel/worker/ivshmem_worker",
    "phase0_vm_id": 0,
    "phase1_run_limit_mode": "both",
    "phase1_runtime_seconds": 20,
    "phase1_total_tasks": 5000
  }
