{
  "_purpose_comment": "V2 production-exec paired oracle multi-proc replayer config — minimized for deterministic capture-vs-replay comparison: only the channel/worker plumbing + kcov + mount/USB cap gate are essential. All fuzz-only subsystems (mutator, corpus queue, dashboard, perf, policy monitor, coverage export, coverage persistence, warmup) are disabled to remove side-channel noise from oracle evidence. channel.transport.n_workers=4 matches a multi-proc syzkaller capture with proc_id in [0..3]; use with SYZ_PROCS<=4.",
  "work_dir": "/workspace/talaria/run/cova-multiproc",
  "retention": false,
  "retention_max": 3,
  "channel": {
    "wait_ready_timeout_ms": 180000,
    "loop_interval_ms": 100,
    "health_check_interval_ms": 500,
    "pre_reboot_drain_ms": 0,
    "input_queue_capacity": 64,
    "abnormal_console_snapshot_lines": 80,
    "vm": {
      "arch": "amd64",
      "image": "/workspace/images-test-linux5.14/bookworm.img",
      "kernel": "/workspace/syzkaller/kernel/build-kasan/arch/x86/boot/bzImage",
      "ssh_key": "/workspace/images-test-linux5.14/bookworm.id_rsa",
      "ssh_user": "root",
      "qemu": {
        "cpu": 2,
        "mem": 4096,
        "cmdline": "nokaslr panic=1 oops=panic",
        "snapshot": true
      }
    },
    "transport": {
      "n_workers": 4,
      "ivshmem_path": "/tmp/refuzz_ivshmem_exec_oracle_replayer_multiproc",
      "ivshmem_mode": "doorbell",
      "doorbell_socket_path": "/tmp/refuzz_ivshmem_exec_oracle_replayer_multiproc.sock",
      "ivshmem_vectors": 4,
      "wait_ready_poll_us": 1000,
      "poll_sleep_us": 100
    },
    "health": {
      "enable": false,
      "sample_interval_ms": 60000,
      "heartbeat_timeout_ms": 60000,
      "workers_per_round": 0
    }
  },
  "executor": {
    "idle_sleep_us": 1000000,
    "submit_wait_for_slot_ms": 0,
    "submit_strategy": {
      "name": "round_robin"
    },
    "event_forward_strategy": {
      "blocking_timeout_ms": 1
    },
    "timeouts_ms": {
      "poll": 1,
      "pop": 5
    }
  },
  "fuzzer": {
    "high_watermark": 64,
    "exec_timeout_ms": 2000,
    "shutdown_grace_ms": 60000,
    "worker_log": {
      "enable": false
    },
    "worker_perf": {
      "enable": false,
      "sample_rate": 1,
      "report_every": 128
    },
    "mutator_policy": "",
    "corpus": {
      "capacity": 0,
      "max_drain": 0
    }
  },
  "telemetry": {
    "policy_monitor": {
      "min_dwell_seconds": 86400,
      "window_size": 10,
      "stall_threshold": 0.01,
      "required_windows": 9999,
      "degraded_channel_ratio": 0.5
    },
    "observability": {
      "pull_interval_ms": 60000
    },
    "dashboard": {
      "enable": false,
      "refresh_interval_ms": 500,
      "max_events": 6,
      "use_alternate_screen": true
    },
    "logging": {
      "enable": false,
      "stream": false,
      "flush_interval_ms": 250,
      "console_summary": false,
      "hot_path_sample_rate": 0
    }
  },
  "target": {
    "execution_mode": "kernel_syscall",
    "coverage_mode": "kcov",
    "sanitizer_mode": "none",
    "sandbox_mode": "none",
    "debug_smaps": false,
    "debug_empty_fork": false,
    "debug_mount_timing": false,
    "_thread_count_comment": "32 is the upper bound enforced by config_parser (matches syzkaller kMaxThreads). Bumped 8 → 32 on 2026-05-19 after observing 38/860 mount-image calls hit reFuzz's KernelThreadPool 'all threads busy' path → flag bit kCallFlagBlocked + skip (kernel_wire_driver.cpp:1257), surfacing as 100% mount_image wire-flag mismatch on the smoke. With 32 threads the pool fans out to syzkaller's own upper bound, eliminating the artificial Blocked-flag emission while keeping memory bounded (N × per_thread_kcov mmap = ~128 MiB max).",
    "thread_count": 32,
    "warmup_devices": false
  },
  "coverage": {
    "kcov": {
      "raw_pc": true,
      "max_pcs_per_exec": 8192,
      "sample_rate": 1.0,
      "drain_seconds": 1,
      "persist_seconds": 1,
      "max_inbox_batches": 64
    },
    "export": {
      "enabled": false
    }
  },
  "persistence": {
    "corpus": {
      "enable": false,
      "load_on_start": false
    },
    "coverage": {
      "enable": false,
      "load_on_start": false
    },
    "crash_repros_as_seeds": false
  },
  "repro": {
    "enable": false,
    "dedicated_vm_count": 0,
    "vmlinux_path": "/workspace/syzkaller/kernel/build-kasan/vmlinux",
    "addr2line_binary": "addr2line",
    "queue_capacity": 0,
    "execute_timeout_ms": 30000
  },
  "phase0_worker_bin": "/workspace/talaria/build-llvm20/executor/channel/worker/ivshmem_worker",
  "phase0_vm_id": 0,
  "phase1_run_limit_mode": "task_count",
  "phase1_runtime_seconds": 30000000,
  "phase1_total_tasks": 100000000
}
