      ],
      "transitions": [
        {
          "rule": "malloc_alloc",
          "from": "EMPTY",
          "api": "MALLOC",
          "to": "ALLOCATED"
        },
        {
          "rule": "malloc_remalloc",
          "from": "ALLOCATED",
          "api": "MALLOC",
          "to": "ALLOCATED"
