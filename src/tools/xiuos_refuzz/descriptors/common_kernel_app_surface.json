          "to": "EMPTY",
          "invalid": true
        },
        {
          "rule": "mutex_invalid_empty_abandon",
          "from": "EMPTY",
          "api": "MUTEX_ABANDON",
          "to": "EMPTY",
          "invalid": true
        },
        {
          "rule": "mutex_double_delete",
          "from": "EMPTY",
          "api": "MUTEX_DELETE",
          "to": "EMPTY",
          "invalid": true
        }
      ]
    },
