        },
        {
          "rule": "timer_modify_created",
          "from": "CREATED",
          "api": "TIMER_MODIFY",
          "to": "CREATED"
        },
        {
          "rule": "timer_modify_running",
          "from": "RUNNING",
          "api": "TIMER_MODIFY",
          "to": "RUNNING"
        },
        {
          "rule": "timer_delete_created",
          "from": "CREATED",
          "api": "TIMER_DELETE",
          "to": "EMPTY"
        },
        {
          "rule": "timer_delete_running",
          "from": "RUNNING",
          "api": "TIMER_DELETE",
          "to": "EMPTY"
        },
        {
          "rule": "timer_invalid_start_empty",
          "from": "EMPTY",
          "api": "TIMER_START_RUN",
          "to": "EMPTY",
          "invalid": true
