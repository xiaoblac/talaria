  "lifecycle": {
    "semaphore": {
      "slot_type": "sem_slot",
      "states": [
        "EMPTY",
        "LIVE"
      ],
      "initial_state": "EMPTY",
      "transitions": [
        {
          "rule": "sem_valid_lifecycle",
          "from": "EMPTY",
          "api": "SEM_CREATE",
          "to": "LIVE"
        },
        {
          "rule": "sem_obtain_live",
          "from": "LIVE",
          "api": "SEM_OBTAIN",
          "to": "LIVE"
        },
        {
          "rule": "sem_abandon_live",
          "from": "LIVE",
          "api": "SEM_ABANDON",
          "to": "LIVE"
        },
        {
          "rule": "sem_set_value_live",
          "from": "LIVE",
          "api": "SEM_SET_VALUE",
          "to": "LIVE"
        },
        {
          "rule": "sem_delete_live",
          "from": "LIVE",
          "api": "SEM_DELETE",
          "to": "EMPTY"
        },
        {
          "rule": "sem_invalid_empty_use",
          "from": "EMPTY",
          "api": "SEM_OBTAIN",
          "to": "EMPTY",
          "invalid": true
        },
        {
          "rule": "sem_invalid_empty_abandon",
          "from": "EMPTY",
          "api": "SEM_ABANDON",
          "to": "EMPTY",
          "invalid": true
        },
        {
          "rule": "sem_double_delete",
          "from": "EMPTY",
          "api": "SEM_DELETE",
          "to": "EMPTY",
          "invalid": true
        }
      ]
    },
    "mutex": {
      "slot_type": "mutex_slot",
      "states": [
        "EMPTY",
        "LIVE",
        "OWNED"
      ],
      "initial_state": "EMPTY",
