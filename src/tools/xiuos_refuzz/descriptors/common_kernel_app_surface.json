          "api": "MUTEX_CREATE",
          "to": "LIVE"
        },
        {
          "rule": "mutex_obtain_live",
          "from": "LIVE",
          "api": "MUTEX_OBTAIN",
          "to": "OWNED"
        },
        {
          "rule": "mutex_abandon_owned",
          "from": "OWNED",
          "api": "MUTEX_ABANDON",
          "to": "LIVE"
        },
        {
          "rule": "mutex_delete_live",
          "from": "LIVE",
          "api": "MUTEX_DELETE",
          "to": "EMPTY"
        },
        {
          "rule": "mutex_delete_owned",
          "from": "OWNED",
          "api": "MUTEX_DELETE",
          "to": "EMPTY"
        },
        {
          "rule": "mutex_invalid_empty_use",
